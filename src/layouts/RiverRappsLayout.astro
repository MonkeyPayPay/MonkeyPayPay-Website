---
import '@fontsource-variable/inter';
import '@fontsource-variable/bitter';
import '@fontsource/pacifico';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const pageTitle = title ? `${title} · American RiverRapps` : 'American RiverRapps — all-American river girl';
const pageDesc =
  description ?? 'American RiverRapps — the style line of bASS SWIM. Prints, textures, and limited drops for the all-American river girl.';
const canonical = new URL(Astro.url.pathname, site.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/bass-favicon-32.png" />
    <link rel="apple-touch-icon" href="/brand/bass-apple-touch.png" />
    <link rel="canonical" href={canonical} />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#f3ead7" />
    <ClientRouter />
  </head>
  <body class="rr-theme">
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="rr-nav" data-nav>
      <div class="container rr-nav__inner">
        <a class="rr-nav__brand" href="/bass-swim/riverrapps" aria-label="American RiverRapps home">
          <img src="/brand/rr-monogram.webp" alt="American RiverRapps" />
        </a>
        <nav class="rr-nav__links" aria-label="Primary">
          <a href="#shop">Shop</a>
          <a href="/bass-swim">The lines</a>
          <a class="rr-nav__back" href="/">MonkeyPayPay ↗</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="rr-footer">
      <div class="container rr-footer__inner">
        <img class="rr-footer__mark" src="/brand/riverrapps-heart.webp" alt="" />
        <p class="rr-footer__tag">All-American river girl.</p>
        <p class="rr-footer__legal">
          © {new Date().getFullYear()} American RiverRapps™ · A line of bASS SWIM ·
          A sister venture of <a href="/">MonkeyPayPay</a>.
        </p>
      </div>
    </footer>

    <script>
      import { initInteractions } from '../scripts/interactions';
      interface RRWindow extends Window {
        __rrInteractions?: boolean;
      }
      const w = window as RRWindow;
      const onScroll = () => {
        const nav = document.querySelector('[data-nav]');
        if (nav) nav.classList.toggle('is-scrolled', window.scrollY > 12);
      };
      if (!w.__rrInteractions) {
        w.__rrInteractions = true;
        document.addEventListener('astro:page-load', initInteractions);
        document.addEventListener('astro:page-load', onScroll);
        window.addEventListener('scroll', onScroll, { passive: true });
      }
    </script>
  </body>
</html>
