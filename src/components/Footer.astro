---
import { site } from '../data/site';
import { apps } from '../data/apps';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <span class="footer__name">{site.name}</span>
      <p class="footer__tag">{site.tagline}</p>
      <nav class="footer__col footer__sitelinks" aria-label="Site">
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/software">Software</a></li>
          <li><a href="/bass-swim">My Wife’s Swim Line</a></li>
          <li><a href="/story">Paisley’s Story</a></li>
          <li><a href="/story#support">Support Paisley</a></li>
          <li><a href={`mailto:${site.contactEmail}`}>Contact</a></li>
        </ul>
      </nav>
    </div>

    <nav class="footer__col footer__col--legal" aria-label="App legal pages">
      <h4>Legal</h4>
      <ul class="footer__legal">
        <li class="footer__legal-head" aria-hidden="true">
          <span></span>
          <span>Privacy</span>
          <span>Terms</span>
        </li>
        {
          apps.map((a) => (
            <li class="footer__legal-row">
              <span class="footer__legal-app">{a.name}</span>
              <a href={`/apps/${a.slug}/privacy`}>
                Privacy<span class="screen-reader-text"> policy for {a.name}</span>
              </a>
              <a href={`/apps/${a.slug}/terms`}>
                Terms<span class="screen-reader-text"> of service for {a.name}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

  </div>

  <div class="container footer__bar">
    <p>© {year} {site.developer}. All rights reserved.</p>
    {
      site.social.length > 0 && (
        <ul class="footer__social">
          {site.social.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener">
                {s.label}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>

  <p class="footer__visits" data-visits hidden aria-hidden="true">
    <span data-visits-n></span> visits
  </p>
</footer>

<script>
  // Subtle site visit counter (Vercel KV backed). Increments once per browser,
  // reads thereafter. Stays hidden unless the endpoint returns a real number,
  // so nothing shows until KV is connected.
  function initVisits() {
    const el = document.querySelector('[data-visits]') as HTMLElement | null;
    if (!el || el.dataset.done) return;
    el.dataset.done = '1';
    const seen = localStorage.getItem('mpp.v');
    fetch('/api/visits', { method: seen ? 'GET' : 'POST' })
      .then((r) => r.json())
      .then(({ count }) => {
        if (count == null) return;
        localStorage.setItem('mpp.v', '1');
        const n = el.querySelector('[data-visits-n]');
        if (n) n.textContent = new Intl.NumberFormat().format(count);
        el.hidden = false;
      })
      .catch(() => {});
  }
  document.addEventListener('astro:page-load', initVisits);
</script>
