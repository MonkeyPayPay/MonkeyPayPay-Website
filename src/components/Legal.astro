---
// Auto-generated Privacy Policy / Terms of Service for an app.
//
// The wording adapts to each app's `legal` config in src/data/apps.ts:
//   • dataModel: 'local-only' renders an accurate "we collect nothing" policy
//     (for no-account, on-device apps like SpinFit); 'standard' (default) uses
//     the generic template.
//   • usesSubscriptions / usesNotifications add the relevant sections.
//
// NOTE: This is a solid plain-language starting point, not legal advice. Give
// it a read before publishing and make sure it matches your app's real
// behaviour and your store "Data safety" answers.
import { site } from '../data/site';
import type { App } from '../data/apps';

interface Props {
  app: App;
  kind: 'privacy' | 'terms';
}

const { app, kind } = Astro.props;
const updated = app.legalLastUpdated ?? '2026-01-01';
const title = kind === 'privacy' ? 'Privacy Policy' : 'Terms of Service';
const contact = app.legal?.contactEmail ?? site.contactEmail;
const localOnly = app.legal?.dataModel === 'local-only';
const subs = app.legal?.usesSubscriptions ?? false;
const notifs = app.legal?.usesNotifications ?? false;
---

<article class="prose legal container">
  <a class="app__back" href={`/apps/${app.slug}`}>← {app.name}</a>
  <h1>{app.name} — {title}</h1>
  <p class="legal__meta">Last updated: {updated}</p>

  {
    kind === 'privacy' ? (
      localOnly ? (
        <>
          <p>
            This Privacy Policy explains how {site.developer} (“we”) handles
            information in the <strong>{app.name}</strong> app (the “App”).
          </p>

          <h2>The short version</h2>
          <p>
            <strong>{app.name} does not collect or transmit your personal data.</strong>{' '}
            There is no account and no sign-up. Your progress, stats, streaks,
            and settings are stored locally on your device and never leave it,
            except as described below.
          </p>

          <h2>Information stored on your device</h2>
          <p>
            The App saves your activity and preferences — for example XP, levels,
            streaks, history, and settings — in local storage on your device. We
            cannot see this information, and it is removed when you delete the App.
          </p>

          {subs && (
            <>
              <h2>Purchases &amp; subscriptions</h2>
              <p>
                If you buy a subscription, the purchase is handled by the Apple
                App Store or Google Play under their terms and privacy policies.
                We use <strong>RevenueCat</strong> to validate and manage
                subscriptions; RevenueCat processes an anonymous app-user
                identifier and your purchase receipt to keep your subscription
                status in sync across your devices. This does not identify you
                personally.
              </p>
            </>
          )}

          {notifs && (
            <>
              <h2>Notifications</h2>
              <p>
                If you turn on reminders, the App schedules local notifications
                on your device. They are generated on-device and are not sent to
                or through our servers.
              </p>
            </>
          )}

          <h2>No tracking or ads</h2>
          <p>
            We do not use advertising or third-party analytics/tracking SDKs, and
            we do not sell your data.
          </p>

          <h2>Children’s privacy</h2>
          <p>
            The App is intended for a general audience and is not directed to
            children under 13. Because we don’t collect personal data, none is
            knowingly collected from anyone.
          </p>

          <h2>Changes</h2>
          <p>
            We may update this policy from time to time. Material changes are
            reflected by updating the “Last updated” date above.
          </p>
        </>
      ) : (
        <>
          <p>
            This Privacy Policy describes how {site.developer} (“we”) handles
            information in connection with the <strong>{app.name}</strong> app
            (the “App”). By using the App you agree to this policy.
          </p>

          <h2>Information we collect</h2>
          <p>
            {app.name} is designed to collect as little as possible. Depending on
            the features you use, we may process information you enter in the App,
            basic device and diagnostic data used to keep the App stable, and
            anonymous, aggregated usage statistics. We do not sell your personal
            information.
          </p>

          <h2>How we use information</h2>
          <p>
            We use the limited information above to operate and improve the App,
            fix problems, and respond to support requests.
          </p>

          <h2>Data sharing</h2>
          <p>
            We share information only with service providers that help us run the
            App, and only as needed to provide those services, or where required
            by law.
          </p>

          <h2>Your choices</h2>
          <p>
            You can stop all collection by uninstalling the App. To request access
            to or deletion of data associated with you, contact us below.
          </p>

          <h2>Children’s privacy</h2>
          <p>
            The App is not directed to children under 13, and we do not knowingly
            collect personal information from them.
          </p>

          <h2>Changes</h2>
          <p>
            We may update this policy from time to time. Material changes are
            reflected by updating the “Last updated” date above.
          </p>
        </>
      )
    ) : (
      <>
        <p>
          These Terms of Service (“Terms”) govern your use of the{' '}
          <strong>{app.name}</strong> app (the “App”) provided by {site.developer}.
          By downloading or using the App you agree to these Terms.
        </p>

        <h2>License</h2>
        <p>
          We grant you a personal, non-exclusive, non-transferable, revocable
          license to use the App for your own lawful, personal use, subject to
          these Terms and the applicable app store’s terms.
        </p>

        <h2>Health &amp; safety</h2>
        <p>
          {app.name} provides general fitness and wellness content and is not
          medical advice. Exercise carries inherent risks — use common sense,
          work within your limits, and consult a physician before starting any
          new exercise program. You are solely responsible for your own safety.
        </p>

        {subs && (
          <>
            <h2>Subscriptions &amp; billing</h2>
            <p>
              The App may offer an auto-renewing subscription. Payment is charged
              to your Apple App Store or Google Play account at confirmation of
              purchase. It renews automatically for the same period and price
              unless cancelled at least 24 hours before the end of the current
              period. You can manage or cancel a subscription anytime in your
              store account settings; the current price is always shown in the
              App before you buy.
            </p>
          </>
        )}

        <h2>Acceptable use</h2>
        <p>
          You agree not to misuse the App, including by reverse-engineering it,
          interfering with its operation, or using it to violate any law or the
          rights of others.
        </p>

        <h2>Intellectual property</h2>
        <p>
          The App, its content, and its branding are owned by {site.developer}
          and protected by applicable intellectual-property laws. These Terms do
          not grant you any rights to our trademarks.
        </p>

        <h2>Disclaimer &amp; limitation of liability</h2>
        <p>
          The App is provided “as is” without warranties of any kind. To the
          fullest extent permitted by law, {site.developer} is not liable for any
          indirect or consequential damages arising from your use of the App.
        </p>

        <h2>Changes &amp; termination</h2>
        <p>
          We may update the App or these Terms at any time, and may suspend or end
          access if you breach them. Continued use after changes means you accept
          the updated Terms.
        </p>
      </>
    )
  }

  <hr />
  <p class="legal__note">
    Questions about this {title.toLowerCase()}? Contact{' '}
    <a href={`mailto:${contact}`}>{contact}</a>.
  </p>
</article>
