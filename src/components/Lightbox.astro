---
// Click any screenshot in a [data-zoom] gallery to open it large (~75% of the
// viewport) over a dimmed backdrop. Close with the ✕, a backdrop click, or Esc.
// Progressive enhancement: the images stay wrapped in <a href={src}>, so with
// JS off (or opened in a new tab) they still resolve to the full-size image.
---

<div class="lightbox" data-lightbox hidden>
  <button class="lightbox__close" type="button" data-lightbox-close aria-label="Close">✕</button>
  <figure class="lightbox__figure">
    <img data-lightbox-img src="" alt="" />
    <figcaption class="lightbox__cap" data-lightbox-cap hidden></figcaption>
  </figure>
</div>

<script>
  interface LBWindow extends Window {
    __mppLightbox?: boolean;
  }

  // Query fresh each time — the ClientRouter replaces the DOM on navigation.
  const boxEl = () => document.querySelector<HTMLElement>('[data-lightbox]');

  function open(src: string, alt: string, caption: string) {
    const box = boxEl();
    if (!box) return;
    const img = box.querySelector<HTMLImageElement>('[data-lightbox-img]');
    const cap = box.querySelector<HTMLElement>('[data-lightbox-cap]');
    if (img) { img.src = src; img.alt = alt || ''; }
    if (cap) { cap.textContent = caption || ''; cap.hidden = !caption; }
    box.hidden = false;
    document.body.style.overflow = 'hidden';
  }
  function close() {
    const box = boxEl();
    document.body.style.overflow = '';
    if (!box) return;
    const img = box.querySelector<HTMLImageElement>('[data-lightbox-img]');
    if (img) img.src = '';
    box.hidden = true;
  }

  const w = window as LBWindow;
  if (!w.__mppLightbox) {
    w.__mppLightbox = true;
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const trigger = target.closest<HTMLElement>('[data-zoom] a, a[data-zoom]');
      if (trigger) {
        e.preventDefault();
        const pic = trigger.querySelector('img');
        const href = trigger.getAttribute('href') || pic?.getAttribute('src') || '';
        open(href, pic?.getAttribute('alt') || '', trigger.getAttribute('data-caption') || '');
        return;
      }
      if (target.closest('[data-lightbox-close]') || target === boxEl()) close();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });
    document.addEventListener('astro:before-swap', close);
  }
</script>
