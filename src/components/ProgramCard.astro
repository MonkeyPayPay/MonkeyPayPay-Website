---
import type { Program } from '../data/programs';
import StoreMeta from './StoreMeta.astro';

interface Props {
  program: Program;
}

const { program } = Astro.props;
const statusLabel = {
  'in-development': 'In development',
  beta: 'Beta',
  live: 'Live',
}[program.status];

// The chef monkey mascot on the Mise card (15-frame knife-flourish sprite).
const mise = program.slug === 'mise';
---

<article class:list={['program', 'reveal', { 'program--chef': mise }]}>
  <div class="program__head">
    {
      program.logo ? (
        <img class="program__mark program__mark--img" src={program.logo} alt={`${program.name} logo`} width="56" height="56" />
      ) : (
        <span class="program__mark" aria-hidden="true">{program.name.charAt(0)}</span>
      )
    }
    <div class="program__heading">
      <h3 class="program__name">{program.name}</h3>
      <p class="program__tagline">{program.tagline}</p>
      <StoreMeta slug={program.slug} />
    </div>
    <span class={`program__status program__status--${program.status}`}>{statusLabel}</span>
  </div>

  <p class="program__desc">{program.description}</p>

  {
    program.highlights && program.highlights.length > 0 && (
      <ul class="program__highlights">
        {program.highlights.map((h) => (
          <li>{h}</li>
        ))}
      </ul>
    )
  }

  <div class="program__foot">
    {
      program.url ? (
        <a class="btn btn--primary" href={program.url} target="_blank" rel="noopener" data-magnetic>
          Explore {program.name}
        </a>
      ) : (
        <a class="btn btn--primary" href={`/software/${program.slug}`}>Explore {program.name}</a>
      )
    }
    {
      program.demoUrl ? (
        <a class="btn btn--store" href={program.demoUrl} target="_blank" rel="noopener">
          Try the demo
        </a>
      ) : (
        <span class="chip chip--soon">Demo coming soon</span>
      )
    }
  </div>

  {mise && <span class="mise-chef" aria-hidden="true"></span>}
</article>
