---
// Santa's sleigh for the wish-list sky (/north-pole only): four galloping
// reindeer (Rudolph up front, nose aglow) pulling Santa and his sack, with a
// twinkling stardust trail. Drawn in SVG, facing left; the page flies it right
// to left across the moon every so often.

// One reindeer, facing left, origin at its chest. Two leg poses (stretched +
// tucked) swap back and forth to make the gallop.
const DEER = [0, 1, 2, 3].map((i) => ({ x: 18 + i * 62, rudolph: i === 0, delay: (i * -0.11).toFixed(2) }));
const stars = Array.from({ length: 9 }, (_, i) => ({
  x: 380 + i * 22 + (i % 2) * 6,
  y: 44 + Math.sin(i * 1.7) * 12,
  r: 2.6 - i * 0.2,
  d: (i * 0.17).toFixed(2),
}));
---

<div class="np-sleigh" aria-hidden="true">
  <svg class="np-sleigh__team" viewBox="0 0 590 96">
    <!-- stardust trail -->
    <path class="np-sleigh__dust" d="M372 52 C430 40 470 66 590 46" />
    {stars.map((s) => <path class="np-sleigh__star" style={`--d:${s.d}s`} transform={`translate(${s.x} ${s.y.toFixed(1)}) scale(${s.r.toFixed(2)})`} d="M0 -3 L.8 -.8 L3 0 L.8 .8 L0 3 L-.8 .8 L-3 0 L-.8 -.8Z" />)}

    <!-- reins from each harness back to the sleigh -->
    <path class="np-sleigh__reins" d="M40 44 Q190 54 300 50 M102 44 Q210 52 300 50 M164 44 Q240 50 300 50 M226 44 Q270 48 300 50" />

    {
      DEER.map((d) => (
        <g class="np-deer" transform={`translate(${d.x} 0)`} style={`--d:${d.delay}s`}>
          <g class="np-deer__bob">
            {/* antlers */}
            <path class="np-deer__antler" d="M10 20 l-3 -10 m3 10 l5 -11 m-6 6 l-6 -3 m9 -1 l5 -4 m-3 -1 l3 -6" />
            {/* head + neck + body + tail */}
            <path
              class="np-deer__body"
              d="M3 25 q-4 1 -5 -2 q1 -4 6 -5 q5 -2 8 1 l4 6 q4 8 8 10 q14 1 24 2 q8 1 9 7 q0 5 -5 6 l-3 -1 q-10 2 -24 1 q-9 0 -12 -6 q-3 -7 -6 -12 q-2 -4 -4 -7z M50 37 l7 -4 l-1 5z"
            />
            {/* front + back legs, stretched */}
            <path class="np-deer__legs np-deer__legs--a" d="M17 45 l-9 9 l-4 1 M22 46 l-6 11 M42 46 l10 8 l3 3 M47 45 l12 6" />
            {/* tucked */}
            <path class="np-deer__legs np-deer__legs--b" d="M17 45 l-3 7 l3 5 M22 46 l1 9 l-2 3 M42 46 l-3 7 l3 4 M47 45 l2 8 l-2 3" />
            {d.rudolph && <circle class="np-deer__nose" cx="-2" cy="23" r="2.6" />}
          </g>
        </g>
      ))
    }

    <!-- the sleigh: Santa, his sack and a curly runner -->
    <g class="np-sleigh__sled">
      <path class="np-sleigh__sack" d="M338 30 q-6 -18 10 -24 q8 -3 14 4 q10 10 2 22z" />
      <path class="np-sleigh__suit" d="M311 32 q11 -8 24 0 l2 10 h-26z" />
      <circle class="np-sleigh__face" cx="322" cy="22" r="6" />
      <path class="np-sleigh__beard" d="M316 23 q6 4 12 0 q1 8 -6 10 q-7 -2 -6 -10z" />
      <path class="np-sleigh__hat" d="M316 18 q4 -12 14 -9 q6 2 8 8 l-4 1 q-2 -4 -6 -5 q-4 4 -12 5z" />
      <circle class="np-sleigh__pom" cx="339" cy="18" r="2.4" />
      <path class="np-sleigh__body" d="M300 34 h68 q8 0 10 -10 q1 -8 8 -8 q4 0 4 4 q-4 0 -4 6 q-2 22 -22 26 h-50 q-12 0 -14 -12z" />
      <path class="np-sleigh__runner" d="M298 70 h80 q14 0 16 -10 M312 58 v12 M352 58 v12 M298 70 q-10 0 -10 -7 q0 -5 5 -5" />
    </g>
  </svg>
</div>

<style>
  .np-sleigh {
    position: absolute;
    top: clamp(96px, 15vw, 200px);
    left: 0;
    width: 100%;
    height: clamp(110px, 14vw, 170px);
    pointer-events: none;
    overflow: hidden;
    z-index: 3; /* in front of the moon: a silhouette against it */
  }
  .np-sleigh__team {
    position: absolute;
    top: 20px;
    left: 100%;
    width: clamp(250px, 38vw, 540px);
    overflow: visible;
    filter: drop-shadow(0 0 6px rgba(255, 215, 106, 0.45));
    animation: np-fly 22s linear infinite;
    animation-delay: 3s;
  }
  /* sweeps in from the right, dips across the moon, climbs away; then rests */
  @keyframes np-fly {
    0% { transform: translate(0, 30px) rotate(-4deg); }
    9% { transform: translate(-36vw, 4px) rotate(2deg); }
    18% { transform: translate(-72vw, 22px) rotate(-3deg); }
    28%, 100% { transform: translate(calc(-100vw - 110%), -26px) rotate(6deg); }
  }

  .np-deer__body,
  .np-sleigh__body,
  .np-sleigh__sack,
  .np-sleigh__suit,
  .np-sleigh__hat { fill: #0a1029; stroke: #ffd76a; stroke-width: 1.1; stroke-linejoin: round; }
  .np-sleigh__hat { fill: #c62839; }
  .np-sleigh__pom,
  .np-sleigh__beard { fill: #fff; }
  .np-sleigh__suit { fill: #c62839; }
  .np-sleigh__face { fill: #f3c9a8; }
  .np-sleigh__body { fill: #8f1b2a; }
  .np-sleigh__sack { fill: #4a2a17; }
  .np-deer__antler,
  .np-deer__legs,
  .np-sleigh__runner { fill: none; stroke: #ffd76a; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .np-deer__antler { stroke-width: 1.5; }
  .np-sleigh__reins { fill: none; stroke: rgba(255, 215, 106, 0.6); stroke-width: 1; }
  .np-sleigh__dust {
    fill: none;
    stroke: rgba(255, 215, 106, 0.45);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 2 10;
    animation: np-dust 0.8s linear infinite;
  }
  @keyframes np-dust { to { stroke-dashoffset: -24; } }
  .np-sleigh__star {
    fill: #ffe9a3;
    animation: np-twinkle-star 1.1s ease-in-out infinite;
    animation-delay: var(--d);
  }
  @keyframes np-twinkle-star { 50% { opacity: 0.15; } }

  /* the gallop: legs swap poses, each deer a beat behind the one in front */
  .np-deer__bob { animation: np-deer-bob 0.44s ease-in-out infinite; animation-delay: var(--d); }
  @keyframes np-deer-bob { 50% { transform: translateY(-4px); } }
  .np-deer__legs--a { animation: np-legs 0.44s steps(1) infinite; animation-delay: var(--d); }
  .np-deer__legs--b { animation: np-legs 0.44s steps(1) infinite reverse; animation-delay: var(--d); }
  @keyframes np-legs {
    0% { opacity: 1; }
    50% { opacity: 0; }
  }
  .np-deer__nose {
    fill: #ff3b3b;
    filter: drop-shadow(0 0 4px #ff3b3b) drop-shadow(0 0 8px #ff6b6b);
    animation: np-nose 1.4s ease-in-out infinite;
  }
  @keyframes np-nose { 50% { opacity: 0.6; } }

  @media (prefers-reduced-motion: reduce) {
    .np-sleigh { display: none; }
  }
</style>
