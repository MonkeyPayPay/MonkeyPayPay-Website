---
import type { App } from '../data/apps';
import PlayIcon from './PlayIcon.astro';
import AppleIcon from './AppleIcon.astro';
import WebIcon from './WebIcon.astro';
import StoreMeta from './StoreMeta.astro';

interface Props {
  app: App;
}

const { app } = Astro.props;
const shots = app.screenshots.slice(0, 4);
---

<article class="card reveal" data-category={app.category}>
  <div class="card__head">
    <a
      class="card__icon"
      href={app.playUrl || `/apps/${app.slug}`}
      {...(app.playUrl ? { target: '_blank', rel: 'noopener' } : {})}
      aria-label={app.playUrl ? `${app.name} on Google Play` : `${app.name} details`}
    >
      <img src={app.icon} alt={`${app.name} icon`} width="72" height="72" loading="lazy" />
    </a>
    <div class="card__heading">
      <h3 class="card__name"><a href={`/apps/${app.slug}`}>{app.name}</a></h3>
      <p class="card__tagline">{app.tagline}</p>
      <StoreMeta slug={app.slug} />
    </div>
  </div>

  <p class="card__desc">{app.description}</p>

  {
    shots.length > 0 && (
      <div class="card__shots" aria-label={`${app.name} screenshots`}>
        {shots.map((s) => (
          <img class="card__shot" src={s.src} alt={s.alt} loading="lazy" />
        ))}
      </div>
    )
  }

  <div class="card__foot">
    <div class="card__stores">
      {
        app.playUrl ? (
          <a class="btn btn--store" href={app.playUrl} target="_blank" rel="noopener">
            <PlayIcon /> Google Play
          </a>
        ) : (
          <span class="chip chip--soon" title="Coming soon to Google Play">
            <PlayIcon /> Google Play · soon
          </span>
        )
      }
      {
        app.appStoreUrl ? (
          <a class="btn btn--store" href={app.appStoreUrl} target="_blank" rel="noopener">
            <AppleIcon /> App Store
          </a>
        ) : (
          <span class="chip chip--soon" title="Coming soon to the App Store">
            <AppleIcon /> App Store · soon
          </span>
        )
      }
      {
        app.webAppUrl ? (
          <a class="btn btn--store" href={app.webAppUrl} target="_blank" rel="noopener">
            <WebIcon /> Web app
          </a>
        ) : (
          <span class="chip chip--soon" title="Web app coming soon">
            <WebIcon /> Web · soon
          </span>
        )
      }
    </div>
    <a class="card__more" href={`/apps/${app.slug}`}>Details →</a>
  </div>
</article>
