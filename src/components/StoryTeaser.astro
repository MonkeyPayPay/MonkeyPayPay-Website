---
import DonateButton from './DonateButton.astro';
---

<section class="teaser">
  <div class="container teaser__inner reveal">
    <p class="teaser__eyebrow">Why MonkeyPayPay?</p>
    <h2 class="teaser__title">Every app here is for a little girl named Paisley.</h2>
    <p class="teaser__text">
      MonkeyPayPay is named after my daughter — the one I call Monkey, and Pay Pay.
      Everything I build is a small step toward giving her the best life I can.
    </p>
    <div class="teaser__actions">
      <a class="btn btn--ghost" href="/story">Read her story</a>
      <span class="teaser__donate">
        <DonateButton />
        <span class="teaser__swing" aria-hidden="true"></span>
      </span>
    </div>
  </div>
</section>
