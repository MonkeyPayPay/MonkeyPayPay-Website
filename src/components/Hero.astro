---
import { site } from '../data/site';
import Monkey3D from './Monkey3D.astro';
---

<section class="hero">
  <div class="hero__mesh" aria-hidden="true"></div>
  <div class="hero__inner container">
    <p class="hero__eyebrow reveal">{site.tagline}</p>
    <h1 class="hero__title reveal">
      <span class="hero__title-grad">{site.name}</span>
    </h1>
    <p class="hero__lead reveal">{site.description}</p>
    <div class="hero__actions reveal">
      <a class="btn btn--primary" href="#apps" data-magnetic>Explore the apps</a>
      <a class="btn btn--ghost" href="/story">Paisley’s story</a>
    </div>
    <Monkey3D
      class="hero__mascot reveal"
      start="wave"
      idle={[['dance1', 2], ['heart', 1], ['dance2', 1], ['cheer', 1], ['dance3', 1], ['bow', 1]]}
      taps={['laugh', 'flip', 'jump', 'heart']}
      label="The MonkeyPayPay mascot waving and dancing"
    />
  </div>
  <a class="hero__scroll" href="#apps" aria-label="Scroll to apps">↓</a>
</section>
