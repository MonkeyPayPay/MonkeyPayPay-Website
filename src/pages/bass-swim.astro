---
import '@fontsource-variable/inter';
import '@fontsource-variable/playfair-display';
import '@fontsource-variable/bitter';
import '@fontsource/pacifico';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { site } from '../data/site';
import { swimBrands, swimLinkAttrs } from '../data/swim';

const bass = swimBrands.bass;
const rr = swimBrands.riverrapps;
const canonical = new URL('/bass-swim', site.url).href;
const title = 'bASS SWIM — two lines, one house';
const desc =
  'bASS SWIM — fitness-first American swimwear. Choose your line: bASS SWIM, or American RiverRapps.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/bass-favicon-32.png" />
    <link rel="apple-touch-icon" href="/brand/bass-apple-touch.png" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#0a0a0a" />
    <ClientRouter />
  </head>
  <body class="chooser-body">
    <a class="skip-link" href="#main">Skip to content</a>

    <div class="chooser__topbar">
      <a class="chooser__back" href="/">← MonkeyPayPay</a>
      <span class="chooser__house">Two lines, one house</span>
    </div>

    <main id="main" class="chooser">
      <a
        class="chooser__half chooser__half--bass"
        href={bass.href}
        {...swimLinkAttrs(bass)}
        aria-label="Enter bASS SWIM"
      >
        <span class="chooser__inner">
          <img class="chooser__logo chooser__logo--bass" src="/brand/bass-logo.webp" alt="bASS SWIM" />
          <span class="chooser__tag chooser__tag--bass">Fitness-first. Made to be seen.</span>
          <span class="chooser__enter chooser__enter--bass">Enter <span aria-hidden="true">→</span></span>
        </span>
      </a>

      <a
        class="chooser__half chooser__half--rr"
        href={rr.href}
        {...swimLinkAttrs(rr)}
        aria-label="Enter American RiverRapps"
      >
        <span class="chooser__inner">
          <img class="chooser__logo chooser__logo--rr" src="/brand/riverrapps-lockup.webp" alt="American RiverRapps" />
          <span class="chooser__tag chooser__tag--rr">All-American river girl.</span>
          <span class="chooser__enter chooser__enter--rr">Enter <span aria-hidden="true">→</span></span>
        </span>
      </a>
    </main>

    <script>
      import { initInteractions } from '../scripts/interactions';
      interface ChooserWindow extends Window {
        __swimChooser?: boolean;
      }
      const w = window as ChooserWindow;
      if (!w.__swimChooser) {
        w.__swimChooser = true;
        document.addEventListener('astro:page-load', initInteractions);
      }
    </script>
  </body>
</html>
