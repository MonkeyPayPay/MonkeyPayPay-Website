---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PlayIcon from '../../../components/PlayIcon.astro';
import AppleIcon from '../../../components/AppleIcon.astro';
import WebIcon from '../../../components/WebIcon.astro';
import { apps, getApp, categoryName } from '../../../data/apps';

export function getStaticPaths() {
  return apps.map((a) => ({ params: { slug: a.slug } }));
}

const { slug } = Astro.params;
const app = getApp(slug as string);
if (!app) {
  return Astro.redirect('/404');
}
---

<BaseLayout title={app.name} description={app.description}>
  <article class="app">
    <div class="container">
      <a class="app__back" href="/#apps">← All apps</a>

      {
        app.splash && (
          <div class="app__hero">
            <img src={app.splash} alt={`${app.name} artwork`} />
          </div>
        )
      }

      <header class="app__header reveal">
        <img class="app__icon" src={app.icon} alt={`${app.name} icon`} width="96" height="96" />
        <div>
          <p class="app__cat">{categoryName(app.category)}</p>
          <h1 class="app__name">{app.name}</h1>
          <p class="app__tagline">{app.tagline}</p>
          <div class="app__stores">
            {
              app.playUrl ? (
                <a class="btn btn--primary" href={app.playUrl} target="_blank" rel="noopener" data-magnetic>
                  <PlayIcon /> Get it on Google Play
                </a>
              ) : (
                <span class="chip chip--soon" title="Coming soon to Google Play">
                  <PlayIcon /> Google Play · coming soon
                </span>
              )
            }
            {
              app.appStoreUrl ? (
                <a class="btn btn--store" href={app.appStoreUrl} target="_blank" rel="noopener">
                  <AppleIcon /> Download on the App Store
                </a>
              ) : (
                <span class="chip chip--soon" title="Coming soon to the App Store">
                  <AppleIcon /> App Store · coming soon
                </span>
              )
            }
            {
              app.webAppUrl ? (
                <a class="btn btn--store" href={app.webAppUrl} target="_blank" rel="noopener">
                  <WebIcon /> Open the web app
                </a>
              ) : (
                <span class="chip chip--soon" title="Web app coming soon">
                  <WebIcon /> Web app · coming soon
                </span>
              )
            }
          </div>
        </div>
      </header>

      <p class="app__desc reveal">{app.description}</p>

      {
        app.screenshots.length > 0 && (
          <div class="app__shots reveal">
            {app.screenshots.map((s) => (
              <img src={s.src} alt={s.alt} loading="lazy" />
            ))}
          </div>
        )
      }

      <p class="app__legal">
        <a href={`/apps/${app.slug}/privacy`}>Privacy Policy</a> ·
        <a href={`/apps/${app.slug}/terms`}>Terms of Service</a>
      </p>
    </div>
  </article>
</BaseLayout>
