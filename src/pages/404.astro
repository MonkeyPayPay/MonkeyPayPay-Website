---
import BaseLayout from '../layouts/BaseLayout.astro';
import Monkey3D from '../components/Monkey3D.astro';
---

<BaseLayout title="Page not found" description="This page could not be found.">
  <section class="notfound container">
    <Monkey3D
      class="notfound__mascot reveal"
      idle={[['oops', 2], ['laugh', 1]]}
      taps={['oops', 'laugh', 'flip']}
      label="The MonkeyPayPay mascot looking puzzled"
    />
    <h1 class="notfound__title reveal">404</h1>
    <p class="notfound__text reveal">
      Looks like this page wandered off the map. Let’s get you back.
    </p>
    <p class="reveal"><a class="btn btn--primary" href="/" data-magnetic>Back home</a></p>
  </section>
</BaseLayout>
